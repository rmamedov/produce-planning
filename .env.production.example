POSTGRES_DB=produce_planning
POSTGRES_USER=produce_planning
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://produce_planning:change-me@db:5432/produce_planning?schema=public
NEXT_PUBLIC_APP_NAME=Kitchen Production Planner
NEXT_PUBLIC_API_BASE_URL=http://localhost
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECURE_COOKIES=false
TASK_GENERATOR_SECRET=replace-with-a-second-long-random-secret
GENERATION_INTERVAL_SECONDS=900
SEED_ON_DEPLOY=false
# Рубікон production transfers (QA). Set RUBICON_MODE=live and the credentials
# to send real documents; with stub nothing leaves the server. Any other
# non-empty value blocks documents. The document endpoint has no login (only a
# same-origin check) — restrict access to the kitchen network before going live.
RUBICON_MODE=stub
RUBICON_API_URL=https://global-api-qa.foodtech.team/external/ecom/v1/ecom/dams/production-transfers
RUBICON_TOKEN_URL=https://identity-public-qa.foodtech.team/connect/token
RUBICON_CLIENT_ID=
RUBICON_CLIENT_SECRET=
RUBICON_SCOPE=ecom--dams--transfer-orchestrator-service:transfer--create
RUBICON_TIMEOUT_MS=15000
