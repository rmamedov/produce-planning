DATABASE_URL="postgresql://postgres:postgres@localhost:5432/produce_planning?schema=public"
NEXT_PUBLIC_APP_NAME="Kitchen Production Planner"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECURE_COOKIES="false"
TASK_GENERATOR_SECRET="replace-with-a-second-long-random-secret"

# Рубікон: production transfers via the e-com external API (QA below).
# stub = nothing is sent, the payload is only logged. Live needs API URL,
# token URL, client id and secret; RUBICON_MODE=live without them fails loudly.
# Only stub, live or empty are accepted — any other value blocks documents.
RUBICON_MODE="stub"
RUBICON_API_URL="https://ecom-ext-api-qa.silpo.dev/v1/ecom/dams/production-transfers"
RUBICON_TOKEN_URL="https://identity-public-qa.foodtech.team/connect/token"
RUBICON_CLIENT_ID=""
RUBICON_CLIENT_SECRET=""
RUBICON_SCOPE="ecom--dams--transfer-orchestrator-service:transfer--create"
RUBICON_TIMEOUT_MS="15000"
